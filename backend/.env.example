# ==============================================================================
# FarmGo Backend - Environment Variables
# ==============================================================================

# Port của server Express
PORT=3001

# Môi trường chạy ('development' hoặc 'production')
NODE_ENV=production

# Khóa bí mật ký JWT Token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=replace_with_strong_random_secret_string_farmgo_2025

# Cấu hình CORS cho phép Frontend truy cập
# Có thể truyền '*' hoặc danh sách domain: https://farmgo.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL (Neon.tech / Supabase / Railway)
# Free Tier Neon: 0.5 GB Postgres Serverless (Miễn phí 100%)
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/farmgo_prod?sslmode=require
