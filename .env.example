# ==============================================================================
# FarmGo Monorepo - Environment Configuration Example
# Sao chép file này thành .env khi chạy môi trường local
# ==============================================================================

# Backend Port
PORT=3001

# Production / Development Mode
NODE_ENV=development

# JWT Secret Key dùng mã hóa token người dùng
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2025

# CORS Allowed Origins (phân cách bằng dấu phẩy)
# Ví dụ production: https://farmgo.vercel.app,https://my-farmgo.netlify.app
CORS_ORIGIN=*

# PostgreSQL Connection String (Neon.tech / Supabase / Railway / Render Postgres)
# Nếu để trống, hệ thống sẽ sử dụng file JSON lưu trữ local tại ./backend/data/farmgo_db.json
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/farmgo_prod?sslmode=require

# Frontend API URL (Dành cho Frontend khi build/deploy)
VITE_API_URL=http://localhost:3001
